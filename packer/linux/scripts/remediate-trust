#!/usr/bin/env bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

# Debian 13 vendor fix, followed by persistent incident exclusions. Do this
# before fetching any third-party keys, scripts, packages or binaries.
while sudo fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1; do sleep 5; done
sudo -E apt-get update -yq
sudo -E apt-get install -yq ca-certificates
version=$(dpkg-query -W -f='${Version}' ca-certificates)
dpkg --compare-versions "$version" ge 20250419+deb13u1 || {
  echo "ca-certificates predates the Debian 13 eMudhra fix: $version" >&2
  exit 1
}

# These are the two incident anchors shipped by Debian. Keep explicit ! entries
# even when the fixed package no longer ships the certificates.
sudo sed -i \
  -e '\|^!*mozilla/emSign_ECC_Root_CA_-_G3.crt$|d' \
  -e '\|^!*mozilla/Comodo_AAA_Services_root.crt$|d' \
  /etc/ca-certificates.conf
printf '%s\n' \
  '!mozilla/emSign_ECC_Root_CA_-_G3.crt' \
  '!mozilla/Comodo_AAA_Services_root.crt' \
  | sudo tee -a /etc/ca-certificates.conf >/dev/null
sudo update-ca-certificates --fresh
