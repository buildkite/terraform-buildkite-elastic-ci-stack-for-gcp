{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "preview:buildkite"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Keep Agent updates within patched v4 releases",
      "matchDepNames": ["buildkite/agent"],
      "allowedVersions": ">=4.7.0 <5"
    },
    {
      "description": "Keep Google Cloud CLI updates above the eMudhra remediation release",
      "matchDepNames": [
        "google-cloud-cli",
        "gcr.io/google.com/cloudsdktool/google-cloud-cli"
      ],
      "allowedVersions": ">=590.0.1",
      "groupName": "Google Cloud CLI"
    },
    {
      "description": "Group all Terraform provider updates together",
      "matchManagers": ["terraform"],
      "matchPackagePatterns": ["*"],
      "groupName": "terraform providers"
    },
    {
      "description": "Preserve Google provider constraints until a release falls outside the supported range",
      "matchManagers": ["terraform"],
      "matchDepTypes": ["required_provider"],
      "matchDepNames": ["google"],
      "rangeStrategy": "replace"
    },
    {
      "description": "Group all Buildkite pipeline updates together",
      "matchManagers": ["buildkite"],
      "groupName": "buildkite pipeline"
    }
  ],
  "customManagers": [
    {
      "description": "Update Buildkite Agent version in Packer install script",
      "customType": "regex",
      "fileMatch": ["^packer/linux/scripts/install-buildkite-agent$"],
      "matchStrings": [
        "AGENT_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "buildkite/agent",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "Update pinned image utilities in the shared versions file",
      "customType": "regex",
      "managerFilePatterns": ["/^packer/linux/scripts/versions\\.sh$/"],
      "matchStrings": [
        "# renovate: depName=(?<depName>[^\\s]+)\\s+export [A-Z0-9_]+=\"v?(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "Update the shared guest Google Cloud CLI and auth plugin pin",
      "customType": "regex",
      "managerFilePatterns": ["/^packer/linux/scripts/versions\\.sh$/"],
      "matchStrings": [
        "GOOGLE_CLOUD_CLI_VERSION=\"(?<currentValue>\\d+\\.\\d+\\.\\d+)-0\""
      ],
      "datasourceTemplate": "custom.google-cloud-cli",
      "depNameTemplate": "google-cloud-cli",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update the metrics function release and GCS generation together",
      "customType": "regex",
      "managerFilePatterns": ["/^main\\.tf$/"],
      "matchStrings": [
        "object\\s*=\\s*\"buildkite-agent-metrics/(?<currentValue>v[^/]+)/buildkite-agent-metrics\\.zip\"\\s+generation\\s*=\\s*(?<currentDigest>\\d+)"
      ],
      "datasourceTemplate": "custom.buildkite-agent-metrics",
      "depNameTemplate": "buildkite/buildkite-agent-metrics",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update GCP Buildkite image references in Terraform variables",
      "customType": "regex",
      "fileMatch": ["^modules/compute/variables\\.tf$"],
      "matchStrings": [
        "default\\s*=\\s*\"projects/buildkite-gcp-stack/global/images/buildkite-ci-stack-x86-64-(?<currentValue>\\d{4}-\\d{2}-\\d{2}-\\d{4})\""
      ],
      "datasourceTemplate": "custom.buildkite-gcp-images",
      "depNameTemplate": "buildkite-ci-stack-x86-64",
      "versioningTemplate": "loose"
    }
  ],
  "customDatasources": {
    "google-cloud-cli": {
      "defaultRegistryUrlTemplate": "https://dl.google.com/dl/cloudsdk/channels/rapid/components-2.json",
      "transformTemplates": [
        "{\"releases\": [{\"version\": version}]}"
      ]
    },
    "buildkite-agent-metrics": {
      "defaultRegistryUrlTemplate": "https://storage.googleapis.com/storage/v1/b/buildkite-cloud-functions/o?prefix=buildkite-agent-metrics/v&fields=items(name,generation,timeCreated)",
      "transformTemplates": [
        "{\"releases\": [items[$match(name, /^buildkite-agent-metrics\\/v\\d+\\.\\d+\\.\\d+\\/buildkite-agent-metrics\\.zip$/)].{\"version\": $split(name, \"/\")[1], \"digest\": generation, \"releaseTimestamp\": timeCreated}], \"sourceUrl\": \"https://github.com/buildkite/buildkite-agent-metrics\"}"
      ]
    }
  }
}
