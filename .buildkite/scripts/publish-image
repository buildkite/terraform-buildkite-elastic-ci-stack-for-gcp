#!/usr/bin/env bash
set -euo pipefail

# Publish a GCP VM image (make public and add to family)
# Usage: ./publish-image <arch>

ARCH="${1:-x86-64}"
PROJECT_ID="${GCP_PROJECT_ID:-buildkite-gcp-stack}"

# Each module major version publishes to its own family, so users referencing
# a family only move to a new major when they change families. Update this
# when main starts the next major version.
MODULE_MAJOR_VERSION="v1"
FAMILY="buildkite-ci-stack-${MODULE_MAJOR_VERSION}-${ARCH}"

# Images published to buildkite-ci-stack-v1-* must use Agent v4.
# Reject other Agent major versions before making the image public.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AGENT_VERSION="$(sed -n 's/^AGENT_VERSION=//p' "$SCRIPT_DIR/../../packer/linux/scripts/install-buildkite-agent")"
if [[ "$MODULE_MAJOR_VERSION" == "v1" && "$AGENT_VERSION" != 4.* ]]; then
  echo "Release blocked: Agent $AGENT_VERSION cannot publish to the Agent v4 family $FAMILY" >&2
  exit 1
fi

echo "--- :earth_americas: Publishing ${ARCH} image"
echo "Project: ${PROJECT_ID}"

# Retrieve the image name from Buildkite metadata
IMAGE_NAME=$(buildkite-agent meta-data get "${ARCH}_image_name")

if [[ -z "$IMAGE_NAME" ]]; then
  echo "Error: Could not retrieve image name from Buildkite metadata (key: ${ARCH}_image_name)"
  exit 1
fi

echo "Found image: $IMAGE_NAME"

# Make the image public
echo "Granting public access to $IMAGE_NAME"
gcloud compute images add-iam-policy-binding "$IMAGE_NAME" \
  --project="$PROJECT_ID" \
  --member="allAuthenticatedUsers" \
  --role="roles/compute.imageUser"

# Add image to family for easy reference
echo "Adding image to family ${FAMILY}"
gcloud compute images update "$IMAGE_NAME" \
  --project="$PROJECT_ID" \
  --family="${FAMILY}"

echo "--- :white_check_mark: Successfully published ${ARCH} image: $IMAGE_NAME"
